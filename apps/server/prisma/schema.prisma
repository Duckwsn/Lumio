generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String        @id @default(cuid())
  displayName String
  email       String?       @unique
  passwordHash String?
  avatar      String?
  status      String?
  lastSeenAt  DateTime?
  createdAt   DateTime      @default(now())
  memberships GroupMember[]
  messages    ChatMessage[]
  queueItems  QueueItem[]
  mediaHistory MediaHistory[]
  favorites     Favorite[]
  progress      PlaybackProgress[]
  libraryItems  GroupLibraryItem[]
  createdPlaylists Playlist[] @relation("PlaylistCreator")
  playlistItems PlaylistItem[] @relation("PlaylistItemAdder")
  houseFavorites HouseFavorite[]
  createdInvites HouseInvite[]
  activity       HouseActivity[]
}

model Group {
  id        String        @id @default(cuid())
  name      String
  avatar    String?
  ownerId   String
  createdAt DateTime      @default(now())
  members   GroupMember[]
  rooms     Room[]
  library   GroupLibraryItem[]
  invites   HouseInvite[]
  activity  HouseActivity[]
  playlists Playlist[]
  houseFavorites HouseFavorite[]
}

model GroupMember {
  id      String @id @default(cuid())
  groupId String
  userId  String
  role    String @default("MEMBER")
  joinedAt DateTime @default(now())
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([groupId, userId])
}

model HouseInvite {
  id          String   @id @default(cuid())
  groupId     String
  createdById String
  tokenHash   String   @unique
  role        String   @default("MEMBER")
  maxUses     Int      @default(1)
  uses        Int      @default(0)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id])
}

model HouseActivity {
  id        String   @id @default(cuid())
  groupId   String
  actorId   String?
  kind      String
  text      String
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

model Room {
  id        String      @id @default(cuid())
  groupId   String
  name      String
  mode      String      @default("watch")
  mediaControl String   @default("everyone")
  queueControl String   @default("everyone")
  skipVotingEnabled Boolean @default(true)
  skipVoteThreshold Int @default(60)
  autoplayNext Boolean @default(true)
  queueRevision Int @default(0)
  createdAt DateTime    @default(now())
  group     Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  queue     QueueItem[]
  messages  ChatMessage[]
  history   MediaHistory[]
}

model QueueItem {
  id             String   @id @default(cuid())
  roomId         String
  addedById      String
  provider       String
  providerMediaId String
  type           String   @default("video")
  title          String
  thumbnail      String?
  duration       Float?
  mimeType       String?
  metadata       String?
  addedAt        DateTime @default(now())
  position       Int      @default(0)
  status         String   @default("queued")
  mediaId        String?
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  addedBy        User     @relation(fields: [addedById], references: [id])
  media           MediaItem? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  @@index([roomId, position])
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model MediaHistory {
  id              String   @id @default(cuid())
  roomId          String
  addedById       String
  provider        String
  providerMediaId String
  type            String   @default("video")
  title           String
  thumbnail       String?
  duration        Float?
  mimeType        String?
  metadata        String?
  playedAt        DateTime @default(now())
  mediaId         String?
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  addedBy         User     @relation(fields: [addedById], references: [id])
  media           MediaItem? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  @@index([roomId, playedAt])
}

model GroupLibraryItem {
  id              String   @id @default(cuid())
  groupId         String
  addedById       String
  provider        String
  providerMediaId String
  type            String   @default("video")
  title           String
  thumbnail       String?
  duration        Float?
  mimeType        String?
  metadata        String?
  addedAt         DateTime @default(now())
  mediaId         String?
  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addedBy         User     @relation(fields: [addedById], references: [id])
  media           MediaItem? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  @@unique([groupId, provider, providerMediaId])
}

model MediaItem {
  id              String   @id @default(cuid())
  provider        String
  providerMediaId String
  type            String   @default("video")
  title           String
  creator         String?
  duration        Float?
  thumbnail       String?
  canonicalUrl    String?
  mimeType        String?
  metadata        String?
  available       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  queueItems       QueueItem[]
  historyEntries  MediaHistory[]
  libraryItems    GroupLibraryItem[]
  playlistItems   PlaylistItem[]
  houseFavorites  HouseFavorite[]
  @@unique([provider, providerMediaId])
  @@index([title])
}

model Playlist {
  id          String   @id @default(cuid())
  groupId     String
  name        String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("PlaylistCreator", fields: [createdById], references: [id])
  items       PlaylistItem[]
  @@index([groupId, updatedAt])
}

model PlaylistItem {
  id        String   @id @default(cuid())
  playlistId String
  mediaId   String
  position  Int
  addedById String
  addedAt   DateTime @default(now())
  playlist  Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  media     MediaItem @relation(fields: [mediaId], references: [id])
  addedBy   User     @relation("PlaylistItemAdder", fields: [addedById], references: [id])
  @@unique([playlistId, mediaId])
  @@unique([playlistId, position])
  @@index([playlistId, position])
}

model HouseFavorite {
  id        String   @id @default(cuid())
  groupId   String
  mediaId   String
  addedById String
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  media     MediaItem @relation(fields: [mediaId], references: [id])
  addedBy   User     @relation(fields: [addedById], references: [id])
  @@unique([groupId, mediaId])
  @@index([groupId, createdAt])
}

model Favorite {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  providerMediaId String
  type            String   @default("video")
  title           String
  thumbnail       String?
  duration        Float?
  mimeType        String?
  metadata        String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, provider, providerMediaId])
}

model PlaybackProgress {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  providerMediaId String
  position        Float
  duration        Float?
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, provider, providerMediaId])
}
