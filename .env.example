PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# PostgreSQL local via infra/compose.postgres.yml. Never commit real credentials.
DATABASE_URL=postgresql://lumio_dev:lumio_local_only@127.0.0.1:5433/lumio_dev?schema=public
PERSISTENCE_MODE=postgres
SESSION_TTL_DAYS=14
APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
# Development default: dev-file (.data/dev-mailbox.jsonl). Production requires resend.
EMAIL_PROVIDER=dev-file
# Optional friend preview: disable new email/password signups while retaining existing logins.
AUTH_SIGNUP_MODE=
VITE_AUTH_SIGNUP_MODE=
EMAIL_FROM=
RESEND_API_KEY=
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google-drive/oauth/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Comma-separated STUN/TURN URLs. TURN is optional for local testing but recommended for remote users.
RTC_STUN_URLS=stun:stun.l.google.com:19302
RTC_TURN_URLS=
RTC_TURN_USERNAME=
RTC_TURN_CREDENTIAL=
